# Copie este arquivo para .env e preencha os valores antes do primeiro deploy.
# O arquivo .env não deve ser versionado.

# Domínio público da aplicação (ex.: agendashows.duckdns.org).
APP_DOMAIN=agendashows.duckdns.org

# Nome do banco e usuário de aplicação criados pelo container do MySQL.
DB_NOME=agendashows
DB_USUARIO=agenda

# Senhas do banco. Use valores longos e aleatórios, sem espaços e sem o caractere #.
DB_SENHA=troque-esta-senha
DB_ROOT_SENHA=troque-esta-senha-root

# Usuário criado automaticamente na primeira execução, quando a tabela está vazia.
USUARIO_INICIAL=admin
SENHA_INICIAL=troque-esta-senha-forte

# E-mail do usuário principal: recebe o relatório semanal de shows toda segunda às 8h.
# Se o usuário já existir e estiver sem e-mail, este valor é aplicado no próximo start.
EMAIL_INICIAL=seu-email@exemplo.com

# SMTP usado no envio do relatório. Sem MAIL_HOST, o envio fica desabilitado.
# Exemplo com Gmail (use uma senha de app, não a senha da conta):
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USUARIO=seu-email@exemplo.com
MAIL_SENHA=sua-senha-de-app
MAIL_REMETENTE=seu-email@exemplo.com
MAIL_AUTH=true
MAIL_STARTTLS=true

# Opcionais: horário (cron do Spring) e fuso do envio.
# EMAIL_RELATORIO_CRON=0 0 8 * * MON
# APP_FUSO=America/Sao_Paulo
